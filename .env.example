# =============================================================================
# TWITCH SONG REQUEST SYSTEM - CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets!
# =============================================================================

# -----------------------------------------------------------------------------
# SPOTIFY CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from https://developer.spotify.com/dashboard
# 1. Create a new app
# 2. Copy Client ID and Client Secret
# 3. Add redirect URI in app settings

SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# IMPORTANT: Use 127.0.0.1 (not localhost) - Spotify requires this exact format
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5174/auth/spotify/callback

# -----------------------------------------------------------------------------
# TWITCH CONFIGURATION
# -----------------------------------------------------------------------------
# Get these from https://dev.twitch.tv/console
# 1. Register a new application
# 2. Set OAuth Redirect URL to the callback below
# 3. Category: Chat Bot

TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here
TWITCH_CHANNEL=your_twitch_channel_name
TWITCH_REDIRECT_URI=http://localhost:5174/auth/twitch/callback

# -----------------------------------------------------------------------------
# BOT ACCOUNT (OPTIONAL)
# -----------------------------------------------------------------------------
# Set USE_BOT_ACCOUNT=true to use a separate account for chat messages
# This makes chat responses appear from "YourBot" instead of your main account

USE_BOT_ACCOUNT=false

# If USE_BOT_ACCOUNT=true, fill these in:
# Get bot token from https://twitchapps.com/tmi/ while logged into bot account
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH_TOKEN=

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
# Port 5174 chosen to avoid conflicts with common streaming tools

SERVER_HOST=127.0.0.1
SERVER_PORT=5174
DEBUG=false

# -----------------------------------------------------------------------------
# QUEUE SETTINGS (Adjustable via Dashboard)
# -----------------------------------------------------------------------------

# Maximum songs allowed in the request queue
MAX_QUEUE_SIZE=10

# Seconds between requests per user (300 = 5 minutes)
COOLDOWN_SECONDS=300

# Number of skip votes needed to auto-skip a song
# (fallback only - used when polls are disabled or unavailable)
SKIP_THRESHOLD=5

# Channel Points cost for song request reward
CHANNEL_POINTS_COST=500

# -----------------------------------------------------------------------------
# SKIP POLL (Affiliate/Partner only - uses Twitch's native anonymous polls)
# -----------------------------------------------------------------------------

# Create a Twitch poll to decide skips instead of a raw vote threshold
POLL_ENABLED=true

# How long the skip poll runs, in seconds (Twitch allows 15-1800)
POLL_DURATION_SECONDS=60

# Number of !pass votes that triggers the skip poll
POLL_TRIGGER_VOTES=2

# Seconds into a requested song before the skip poll starts automatically
# (0 = polls only start from !pass votes)
POLL_AUTO_START_SECONDS=30

# Minimum Skip votes the poll needs to actually skip (majority alone is not enough)
POLL_MIN_SKIP_VOTES=4

# End the poll early and skip when Skip has this % of votes and the minimum
# is met (0 = always wait for the full poll duration)
POLL_LANDSLIDE_PERCENT=70

# End the poll and skip the moment Skip reaches this many votes, regardless
# of percentage (0 = off). Useful because happy viewers rarely vote Keep.
POLL_INSTANT_SKIP_VOTES=6

# How many votes a moderator's !pass counts for in the internal tally
MOD_PASS_WEIGHT=1

# Maximum requested song length in seconds (300 = 5 minutes, 0 = no limit)
MAX_SONG_DURATION_SECONDS=300

# -----------------------------------------------------------------------------
# BLOCKLIST (Comma-separated, no spaces)
# -----------------------------------------------------------------------------
# Block specific artists or songs from being requested

# Artist names to block (case-insensitive partial match)
# Example: BLOCKLIST_ARTISTS=Nickelback,Justin Bieber
BLOCKLIST_ARTISTS=

# Spotify track IDs to block
# Example: BLOCKLIST_SONG_IDS=4iV5W9uYEdYUVa79Axb7Rh,1234567890abcdef
BLOCKLIST_SONG_IDS=
